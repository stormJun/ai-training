flowchart TD
    A["当前会话上下文增长"] --> B["进入 query 前预处理"]
    B --> C["snip"]
    C --> D["microcompact"]
    D --> E["context collapse"]
    E --> F{"是否仍然超过压缩阈值"}
    F -- "否" --> G["直接继续当前请求"]
    F -- "是" --> H["进入主压缩路径"]
    H --> I["生成 post-compact context"]
    I --> J["继续当前轮或下一轮工作"]

    K["手动 /compact"] --> H
    L["消息选择器触发局部压缩"] --> M["局部压缩"]
    M --> I

    N["当前请求已失败"] --> O{"错误是否可通过压缩恢复"}
    O -- "是" --> P["恢复式压缩"]
    P --> I
    O -- "否" --> Q["错误直接返回"]