# 复制本文件为 .env 并填入真实值。
# .env 已被根 .gitignore 忽略，不会提交，可安全存放密钥。
#
# 火山方舟 Agent Plan 配置（OpenAI 兼容协议）：
#   - Key 与端点均与普通 Ark 不同，请用 Agent Plan 专属 Key
#   - 模型可直接按名调用，免开通
ARK_API_KEY=ark-你的AgentPlan专属Key
ARK_MODEL_ID=ark-code-latest
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

# 备选模型：doubao-seed-2.0-pro / doubao-seed-2.0-lite / deepseek-v4-pro / glm-5.2 / kimi-k2.7-code 等
# 若改用普通 Ark：删掉 ARK_BASE_URL，ARK_MODEL_ID 填接入点 ID(ep-xxx) 或已开通的模型 ID
