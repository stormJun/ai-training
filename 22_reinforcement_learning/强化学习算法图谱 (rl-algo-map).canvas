		{"id":"text_0122","type":"text","text":"Framework","x":-841,"y":7333,"width":100,"height":26},
		{"id":"text_0123","type":"text","text":"PPO等等","x":-1163,"y":-4344,"width":81,"height":26},
		{"id":"text_0124","type":"text","text":"确定性策略vs随机性策略","x":-1275,"y":-4192,"width":192,"height":26},
		{"id":"text_0125","type":"text","text":"仿真","x":-962,"y":7271,"width":46,"height":26},
		{"id":"text_0126","type":"text","text":"算法库","x":-979,"y":7394,"width":63,"height":26},
		{"id":"text_0127","type":"text","text":"Ray RLlib","x":-1137,"y":7323,"width":85,"height":26},
		{"id":"text_0128","type":"text","text":"SB3","x":-1096,"y":7373,"width":43,"height":26},
		{"id":"text_0129","type":"text","text":"大模型RL","x":-1134,"y":7466,"width":83,"height":26},
		{"id":"text_0130","type":"text","text":"TRL","x":-1251,"y":7422,"width":45,"height":26},
		{"id":"text_0131","type":"text","text":"OpenRLHF","x":-1305,"y":7466,"width":95,"height":26},
		{"id":"text_0132","type":"text","text":"VeRL\n字节","x":-1383,"y":7515,"width":173,"height":26},
		{"id":"text_0133","type":"text","text":"https://docs.ray.io/en/latest/rllib/index.html","x":-1589,"y":7323,"width":347,"height":26},
		{"id":"text_0134","type":"text","text":"Gym\nhttps://gymnasium.farama.org/environments/mujoco/","x":-1644,"y":7271,"width":608,"height":26},
		{"id":"text_0135","type":"text","text":"https://huggingface.co/learn/deep-rl-course/unit0/introduction","x":-1634,"y":7220,"width":493,"height":26},
		{"id":"text_0136","type":"text","text":"https://rail.eecs.berkeley.edu/deeprlcourse/","x":-1323,"y":7168,"width":342,"height":26},
		{"id":"text_0137","type":"text","text":"https://book.douban.com/subject/37331056/","x":-1514,"y":7116,"width":351,"height":26},
		{"id":"text_0138","type":"text","text":"http://incompleteideas.net/book/RLbook2020.pdf","x":-1602,"y":7065,"width":389,"height":26},
		{"id":"text_0139","type":"text","text":"https://github.com/changyeyu/LLM-RL-Visualized","x":-1596,"y":7013,"width":388,"height":26},
		{"id":"text_0140","type":"text","text":"RL发展历史","x":912,"y":-7435,"width":99,"height":26},
		{"id":"text_0141","type":"text","text":"RL之父\nRichard S. Sutton","x":913,"y":-7230,"width":145,"height":45},
		{"id":"text_0142","type":"text","text":"RL的应用","x":912,"y":-7011,"width":83,"height":26},
		{"id":"text_0143","type":"text","text":"智能体（Agent）：负责决策的实体，感知当前环境的状态，并基于策略选择并执行动作，智能体即自动驾驶汽车。","x":1798,"y":-6529,"width":837,"height":26},
		{"id":"text_0144","type":"text","text":"策略（Policy，π）：决定智能体在给定状态下应采取的动作规则或准则，是智能体行为的核心","x":1798,"y":-6484,"width":687,"height":26},
		{"id":"text_0145","type":"text","text":"动作（Action，A）：智能体在特定状态下可以选择并执行的操作。汽车行进的路线和方向。","x":1798,"y":-6439,"width":672,"height":26},
		{"id":"text_0146","type":"text","text":"环境（Environment）：智能体所处的外部环境，定义了状态空间、动作空间、状态转移概率和奖励函数","x":1798,"y":-6395,"width":758,"height":26},
		{"id":"text_0147","type":"text","text":"状态（State，S）：环境在某一时刻的具体情况描述，包含了智能体决策所需的信息，S1=张家界。","x":1798,"y":-6353,"width":725,"height":31},
		{"id":"text_0148","type":"text","text":"奖励（Reward，R）：智能体执行动作后，环境给予智能体的即时反馈信号，能反映出动作的好坏","x":1798,"y":-6306,"width":716,"height":26},
		{"id":"text_0149","type":"text","text":"轨迹（Trajectory, 通常简写为τ）：智能体从初始状态到终止状态所经历的一系列状态、动作和奖励的序列。","x":1798,"y":-6264,"width":791,"height":31},
		{"id":"text_0150","type":"text","text":"回合（Episode）：一次完整的交互过程，从智能体的初始状态开始，经过一系列状态转移和动作选择，直到达到终止状态。","x":1798,"y":-6219,"width":901,"height":31},
		{"id":"text_0151","type":"text","text":"状态空间（State Space）：所有可能状态的集合（图中的9个城市）。","x":1798,"y":-6172,"width":518,"height":26},
		{"id":"text_0152","type":"text","text":"动作空间（Action Space）：所有可能动作的集合（图中的箭头）。","x":1798,"y":-6128,"width":500,"height":26},
		{"id":"text_0156","type":"text","text":"推荐系统等其他场景","x":1068,"y":-6944,"width":160,"height":26},
		{"id":"text_0157","type":"text","text":"定义","x":-1153,"y":-5420,"width":46,"height":26},
		{"id":"text_0158","type":"text","text":"DPG","x":-1155,"y":-4904,"width":47,"height":26},
		{"id":"text_0159","type":"text","text":"Star⭐，关注实时更新","x":-1850,"y":7013,"width":171,"height":28},
		{"id":"text_0160","type":"text","text":"DPG简介","x":-1310,"y":-5198,"width":80,"height":26},
		{"id":"text_0161","type":"text","text":"DDPG","x":-1289,"y":-4611,"width":59,"height":26},
		{"id":"text_0162","type":"text","text":"DDPG原理","x":-1456,"y":-4748,"width":91,"height":26},
		{"id":"text_0163","type":"text","text":"TD3","x":-1410,"y":-4473,"width":45,"height":26},
		{"id":"text_0164","type":"text","text":"David Silver","x":-1488,"y":-5371,"width":101,"height":26},
		{"id":"text_0165","type":"text","text":"DPG原理","x":-1465,"y":-5232,"width":80,"height":26},
		{"id":"text_0166","type":"text","text":"DPG的LOSS与梯度","x":-1537,"y":-5024,"width":152,"height":26},
		{"id":"text_0167","type":"text","text":"双延迟深度确定性策略梯度（Twin Delayed Deep Deterministic Policy Gradient, TD3）","x":-2177,"y":-4531,"width":650,"height":26},
		{"id":"text_0168","type":"text","text":"对DDPG（Deep Deterministic Policy Gradient）的显著改进","x":-1952,"y":-4486,"width":451,"height":26},
		{"id":"text_0169","type":"text","text":"训练过程中，需要加载6个模型","x":-1717,"y":-4415,"width":234,"height":26},
		{"id":"text_0170","type":"text","text":"价值网络的Loss","x":-1741,"y":-5068,"width":130,"height":26},
		{"id":"text_0171","type":"text","text":"策略网络的策略梯度","x":-1772,"y":-4980,"width":160,"height":26},
		{"id":"text_0172","type":"text","text":"2个策略网络（Actor）","x":-1971,"y":-4437,"width":178,"height":26},
		{"id":"text_0173","type":"text","text":"4个评估网络（Critic）","x":-1969,"y":-4393,"width":176,"height":26},
		{"id":"text_0174","type":"text","text":"DeepMind","x":-1657,"y":-5371,"width":90,"height":26},
		{"id":"text_0175","type":"text","text":"DPG采用确定性策略，将状态直接映射到具体的动作。","x":-2437,"y":-5299,"width":404,"height":26},
		{"id":"text_0176","type":"text","text":"DPG利用策略梯度算法直接优化确定性策略。","x":-2372,"y":-5255,"width":339,"height":26},
		{"id":"text_0177","type":"text","text":"DPG采用了演员-评委（Actor-Critic）架构","x":-2353,"y":-5210,"width":319,"height":26},
		{"id":"text_0178","type":"text","text":"DPG是一个异策略算法，这意味着它可以利用来自不同策略的数据进行学习，从而在探索和利用之间取得更好的平衡。","x":-2914,"y":-5168,"width":857,"height":31},
		{"id":"text_0182","type":"text","text":"在每个状态下，策略都会输出一个确定的动作。也就是说，对于给定的状态s，策略函数始终映射到同一个特定动作a。","x":-2097,"y":-5422,"width":857,"height":31},
		{"id":"text_0183","type":"text","text":"The Bitter Lesson","x":1668,"y":-7155,"width":150,"height":26},
		{"id":"text_0184","type":"text","text":"The two methods that seem to scale arbitrarily in","x":1904,"y":-7193,"width":389,"height":26},
		{"id":"text_0185","type":"text","text":"this way are search and learning.","x":1968,"y":-7173,"width":261,"height":26},
		{"id":"text_0186","type":"text","text":"http://incompleteideas.net/IncIdeas/BitterLesson.html","x":1926,"y":-7128,"width":430,"height":26},
		{"id":"text_0187","type":"text","text":"在训练过程中需要加载4个模型","x":-2315,"y":-4748,"width":234,"height":26},
		{"id":"text_0188","type":"text","text":"HRL","x":-804,"y":6205,"width":46,"height":26},
		{"id":"text_0189","type":"text","text":"分布价值强化学习（Distributional RL）","x":-1062,"y":6739,"width":303,"height":26},
		{"id":"text_0190","type":"text","text":"2个策略网络（Actor）","x":-2568,"y":-4771,"width":178,"height":26},
		{"id":"text_0191","type":"text","text":"2个评估网络（Critic）","x":-2566,"y":-4726,"width":176,"height":26},
		{"id":"text_0192","type":"text","text":"分层强化学习（Hierarchical Reinforcement Learning）","x":-1310,"y":6205,"width":419,"height":26},
		{"id":"text_0193","type":"text","text":"逻辑推理（Reasoning）","x":-1022,"y":4528,"width":191,"height":26},
		{"id":"text_0194","type":"text","text":"答案空间的充分搜索","x":-989,"y":5232,"width":160,"height":26},
		{"id":"text_0195","type":"text","text":"一种分而治之的强化学习框架，通过将复杂的任务分解为多个层次的较小的子任务或子策略，使智能体能够在不同的抽象层次上学习和决策","x":-2418,"y":6140,"width":1002,"height":31},
		{"id":"text_0196","type":"text","text":"封建等级强化学习（Feudal Reinforcement Learning, Feudal RL）","x":-1941,"y":6268,"width":496,"height":26},
		{"id":"text_0197","type":"text","text":"BoN（Best-of-N）采样","x":-1252,"y":4821,"width":188,"height":26},
		{"id":"text_0198","type":"text","text":"多数投票（Majority Vote）方法","x":-1313,"y":5050,"width":246,"height":26},
		{"id":"text_0199","type":"text","text":"拒绝采样（Rejection Sampling）微调","x":-1357,"y":5303,"width":288,"height":26},
		{"id":"text_0200","type":"text","text":"MCTS","x":-1123,"y":5643,"width":59,"height":26},
		{"id":"text_0201","type":"text","text":"定义","x":-1184,"y":6612,"width":46,"height":26},
		{"id":"text_0202","type":"text","text":"分布价值强化学习与传统强化学习的区别","x":-1443,"y":6867,"width":306,"height":26},
		{"id":"text_0203","type":"text","text":"蒙特卡洛树搜索（MCTS，Monte Carlo Tree Search）","x":-1610,"y":5482,"width":408,"height":26},
		{"id":"text_0204","type":"text","text":"MCTS原理","x":-1289,"y":5804,"width":91,"height":26},
		{"id":"text_0205","type":"text","text":"MCTS的四个关键步骤","x":-1536,"y":5657,"width":172,"height":26},
		{"id":"text_0206","type":"text","text":"MCTS的运行过程","x":-1504,"y":5952,"width":140,"height":26},
		{"id":"text_0207","type":"text","text":"（1）选择（Selection）：从根节点出发，按照一定的策略（例如UCB1、PUCT、贪心策略、Ɛ-贪心），递归地选择最有潜力的子节点，直到\n到达一个未完全扩展的节点（该节点至少存在一个尚未被访问的子节点）。","x":-3129,"y":5550,"width":1021,"height":50},
		{"id":"text_0208","type":"text","text":"（2）扩展（Expansion）：在到达未完全扩展的节点时，从中选择一个未被访问过的子节点进行扩展，生成新的子节点，以探索新的可能性。\n如果当前节点是终止状态（例如游戏结束），则跳过扩展步骤。","x":-3129,"y":5613,"width":1024,"height":48},
		{"id":"text_0209","type":"text","text":"（3）推演（Simulation/Rollout）：从新扩展的节点开始，进行模拟或推演，直到到达终止状态。在推演过程中，可以根据随机策略或具体规\n则得到一个胜负结果或奖励得分。","x":-3129,"y":5679,"width":1024,"height":48},
		{"id":"text_0210","type":"text","text":"（4）回溯更新（Backpropagation）：推演完成后，将最终结果（奖励或得分）沿搜索路径反向传播至根节点，更新路径上每个节点的统计\n信息（例如该节点的访问次数N和累计回报V）。这些统计信息将在后续选择步骤中用于指导搜索方向。","x":-3129,"y":5742,"width":1011,"height":45},
		{"id":"text_0211","type":"text","text":"是一种基于模拟和采样的决策树搜索算法","x":-1990,"y":5457,"width":306,"height":31},
		{"id":"text_0212","type":"text","text":"2016年，DeepMind在AlphaGo系统中结合深度神经网络与MCTS，成功击败围棋世界冠军李世石","x":-2710,"y":5504,"width":704,"height":26},
		{"id":"text_0213","type":"text","text":"直接对回报（累积奖励）的分布进行建模，而不仅仅是对其期望值进行估计","x":-1847,"y":6612,"width":549,"height":26},
		{"id":"text_0214","type":"text","text":"Hinton","x":-2128,"y":6191,"width":66,"height":26},
		{"id":"text_0215","type":"text","text":"基于CoT的知识蒸馏","x":-1259,"y":4528,"width":159,"height":26},
		{"id":"text_0216","type":"text","text":"IL定义","x":-945,"y":3372,"width":61,"height":26},
		{"id":"text_0217","type":"text","text":"IL分类","x":-945,"y":3975,"width":61,"height":26},
		{"id":"text_0218","type":"text","text":"基于DeepSeek进行蒸馏","x":-1522,"y":4528,"width":185,"height":26},
		{"id":"text_0219","type":"text","text":"行为克隆\n（BC，Behavior Cloning）","x":-1233,"y":3644,"width":211,"height":45},
		{"id":"text_0220","type":"text","text":"逆向强化学习\n（IRL，Inverse RL）","x":-1184,"y":3979,"width":167,"height":45},
		{"id":"text_0221","type":"text","text":"生成对抗模仿学习\n（Generative Adversarial Imitation Learning，GAIL）","x":-1435,"y":4277,"width":412,"height":45},
		{"id":"text_0222","type":"text","text":"逆向强化学习（Inverse Reinforcement Learning, IRL）指的是根据专家或智能体的行为，推断其背后的奖励函数，然后，基于此奖励函数学习最优策略。基于强化学习方法，通过推断奖励函数间接学习策略。","x":-2785,"y":3877,"width":1504,"height":26},
		{"id":"text_0223","type":"text","text":"吴恩达（Andrew Y. Ng）","x":-1457,"y":3926,"width":195,"height":26},
		{"id":"text_0224","type":"text","text":"IRL vs RL","x":-1349,"y":4099,"width":84,"height":26},
		{"id":"text_0225","type":"text","text":"定义","x":-1356,"y":3571,"width":46,"height":26},
		{"id":"text_0226","type":"text","text":"其主要目标是让智能体通过观察和模仿专家的行为来学习执行任务，而无需预先定义具体的奖励函数。","x":-2330,"y":4272,"width":743,"height":26},
		{"id":"text_0227","type":"text","text":"定义\n由斯坦福大学的研究团队于2016年发表，是一种结合了生成对抗网络（GAN）与模仿学习（IL）理念的机器学习方法。","x":-2543,"y":4318,"width":1031,"height":31},
		{"id":"text_0228","type":"text","text":"《Algorithms for Inverse Reinforcement Learning》","x":-1940,"y":3926,"width":401,"height":26},
		{"id":"text_0229","type":"text","text":"一种通过观察并模仿专家行为来学习复杂任务的机器学习方法。","x":-1538,"y":3310,"width":468,"height":31},
		{"id":"text_0230","type":"text","text":"模仿学习与其他机器学习范式的关系","x":-1295,"y":3431,"width":273,"height":26},
		{"id":"text_0231","type":"text","text":"AC架构的定义","x":-947,"y":1244,"width":115,"height":26},
		{"id":"text_0232","type":"text","text":"A2C","x":-875,"y":2224,"width":44,"height":26},
		{"id":"text_0233","type":"text","text":"A3C","x":-875,"y":3142,"width":44,"height":26},
		{"id":"text_0234","type":"text","text":"SAC","x":-875,"y":3240,"width":44,"height":26},
		{"id":"text_0235","type":"text","text":"行为克隆（Behavioral Cloning, BC）是一种结合了监督学习的机器学习方法，通过学习专家在不同状态（State）下采取的动作（Action）的映射关系来模仿专家的行为","x":-2706,"y":3546,"width":1214,"height":31},
		{"id":"text_0236","type":"text","text":"基于监督学习方法，直接从专家的状态-动作对中学习映射关系。","x":-1928,"y":3594,"width":474,"height":26},
		{"id":"text_0237","type":"text","text":"Soft Actor-Critic","x":-1088,"y":3216,"width":138,"height":26},
		{"id":"text_0238","type":"text","text":"特色\nSAC在标准的最大化期望奖励目标上，增加了熵最大化项。","x":-1532,"y":3264,"width":582,"height":26},
		{"id":"text_0239","type":"text","text":"该算法通过结合最大熵（Maximum Entropy）框架与异策略（Off-Policy）学习，提供了一种高效且稳定的强化学习方法。","x":-2108,"y":3213,"width":891,"height":31},
		{"id":"text_0240","type":"text","text":"定义","x":-997,"y":3106,"width":46,"height":26},
		{"id":"text_0241","type":"text","text":"DeepMind等研究团队于2016年发表","x":-1226,"y":3167,"width":272,"height":26},
		{"id":"text_0242","type":"text","text":"A2C的定义","x":-1043,"y":1524,"width":92,"height":26},
		{"id":"text_0243","type":"text","text":"Advantage","x":-1047,"y":1958,"width":96,"height":26},
		{"id":"text_0244","type":"text","text":"（优势）","x":-1039,"y":1977,"width":79,"height":26},
		{"id":"text_0245","type":"text","text":"A2C方法中的策略梯度公式","x":-1157,"y":2924,"width":205,"height":26},
		{"id":"text_0246","type":"text","text":"A2C（Advantage Actor-Critic，优势演员-评委）是一种改进的演员-评委算法。","x":-1721,"y":1499,"width":585,"height":31},
		{"id":"text_0247","type":"text","text":"与基础的AC（Actor-Critic）方法相比，A2C引入了优势函数，用于衡量当前动作相对于平均水平的优劣，从而提高了学习效率和稳定性。","x":-2188,"y":1546,"width":993,"height":26},
		{"id":"text_0248","type":"text","text":"Actor-Critic方法的扩展，通过并行地运行多个智能体（Agents），每个智能体在不同的环境实例中独立地与环境交互，并且异步地更新全局模型参数。","x":-2177,"y":3084,"width":1094,"height":26},
		{"id":"text_0249","type":"text","text":"Asynchronous Advantage Actor-Critic，异步优势演员-评委","x":-1558,"y":3129,"width":448,"height":26},
		{"id":"text_0250","type":"text","text":"引入基线（Baseline）","x":-1298,"y":1619,"width":175,"height":26},
		{"id":"text_0251","type":"text","text":"引入基线 作用","x":-1238,"y":1844,"width":115,"height":26},
		{"id":"text_0252","type":"text","text":"Advantage的计算方法\nGAE","x":-1422,"y":2315,"width":298,"height":26},
		{"id":"text_0253","type":"text","text":"该架构有效融合了基于策略（Policy-Based）和基于价值（Value-Based）的方法，\n结合了两种方法的优势，通过同时学习策略和价值函数来提升学习效率与稳定性，是一种混合型方法。","x":-1797,"y":1091,"width":743,"height":48},
		{"id":"text_0254","type":"text","text":"策略梯度定理，使用一个价值模型来近似动作价值函数","x":-1425,"y":1226,"width":403,"height":31},
		{"id":"text_0255","type":"text","text":"AC架构","x":-1090,"y":1387,"width":67,"height":26},
		{"id":"text_0256","type":"text","text":"无需明确的奖励函数，而是直接从专家的示范中学习策略。","x":-2173,"y":3313,"width":435,"height":26},
		{"id":"text_0257","type":"text","text":"蒙特卡洛\n（Monte Carlo, MC）","x":-968,"y":-2589,"width":172,"height":45},
		{"id":"text_0258","type":"text","text":"TD\n（Temporal Difference, 时序差分 ）","x":-1073,"y":-507,"width":278,"height":45},
		{"id":"text_0259","type":"text","text":"Single Agent","x":-843,"y":-3906,"width":108,"height":26},
		{"id":"text_0260","type":"text","text":"多智能体强化学习\n（MARL，Multi-agent reinforcement learning）","x":-1110,"y":-3257,"width":372,"height":45},
		{"id":"text_0261","type":"text","text":"TD的定义","x":-1234,"y":-1867,"width":85,"height":26},
		{"id":"text_0262","type":"text","text":"TD的分类","x":-1234,"y":-1096,"width":85,"height":26},
		{"id":"text_0263","type":"text","text":"SARSA","x":-1214,"y":-845,"width":63,"height":26},
		{"id":"text_0264","type":"text","text":"Q-Learning","x":-1250,"y":-469,"width":97,"height":26},
		{"id":"text_0265","type":"text","text":"MC 对比 TD","x":-1252,"y":871,"width":101,"height":26},
		{"id":"text_0266","type":"text","text":"自博弈（Self-Play）","x":-1352,"y":-3731,"width":162,"height":26},
		{"id":"text_0267","type":"text","text":"MARL定义","x":-1281,"y":-3248,"width":91,"height":26},
		{"id":"text_0268","type":"text","text":"MARL算法举例","x":-1314,"y":-2788,"width":123,"height":26},
		{"id":"text_0269","type":"text","text":"MADDPG（Multi-Agent DDPG）","x":-1649,"y":-2856,"width":254,"height":26},
		{"id":"text_0270","type":"text","text":"MAPPO","x":-1462,"y":-2720,"width":73,"height":26},
		{"id":"text_0271","type":"text","text":"降低梯度估计的方差","x":-1991,"y":1821,"width":160,"height":26},
		{"id":"text_0272","type":"text","text":"使梯度更新更具区分性","x":-2007,"y":1866,"width":176,"height":26},
		{"id":"text_0273","type":"text","text":"Multi-Agent PPO, 多智能体PPO","x":-1789,"y":-2720,"width":250,"height":26},
		{"id":"text_0274","type":"text","text":"OpenAI","x":-1800,"y":-2769,"width":68,"height":26},
		{"id":"text_0275","type":"text","text":"多个智能体，它们共享同一个环境","x":-1614,"y":-3250,"width":257,"height":31},
		{"id":"text_0276","type":"text","text":"DEC-POMDP","x":-1800,"y":-3213,"width":110,"height":26},
		{"id":"text_0277","type":"text","text":"DEC-MDP","x":-1777,"y":-3122,"width":87,"height":26},
		{"id":"text_0278","type":"text","text":"定义","x":-1543,"y":2093,"width":46,"height":26},
		{"id":"text_0279","type":"text","text":"GAE算法的公式","x":-1623,"y":2266,"width":126,"height":26},
		{"id":"text_0280","type":"text","text":"2个重要超参数","x":-1616,"y":2538,"width":120,"height":26},
		{"id":"text_0281","type":"text","text":"Q-Learning的更新、训练公式","x":-1556,"y":-688,"width":228,"height":26},
		{"id":"text_0282","type":"text","text":"Q-Learning的分类","x":-1475,"y":-251,"width":147,"height":26},
		{"id":"text_0283","type":"text","text":"γ","x":-1719,"y":2455,"width":24,"height":26},
		{"id":"text_0284","type":"text","text":"λ","x":-1719,"y":2620,"width":24,"height":26},
		{"id":"text_0285","type":"text","text":"Q-table","x":-1622,"y":-525,"width":71,"height":26},
		{"id":"text_0286","type":"text","text":"Q-network","x":-1647,"y":24,"width":96,"height":26},
		{"id":"text_0287","type":"text","text":"可以调整多步TD误差δ在优势估计中的权重分布和衰减程度，取值范围是[0, 1]","x":-2390,"y":2562,"width":570,"height":26},
		{"id":"text_0288","type":"text","text":"作用","x":-1845,"y":2679,"width":46,"height":26},
		{"id":"text_0289","type":"text","text":"DQN","x":-1773,"y":24,"width":49,"height":26},
		{"id":"text_0290","type":"text","text":"能够更直接地在偏差和方差之间取得平衡","x":-2225,"y":2679,"width":306,"height":26},
		{"id":"text_0291","type":"text","text":"DeepMind，2013年提出，深度Q网络（Deep Q-Network, DQN）","x":-2389,"y":-445,"width":487,"height":26},
		{"id":"text_0292","type":"text","text":"DQN的输入、输出结构","x":-2030,"y":-308,"width":179,"height":26},
		{"id":"text_0293","type":"text","text":"DQN的实际应用方式","x":-2014,"y":-58,"width":163,"height":26},
		{"id":"text_0294","type":"text","text":"特性与改进","x":-1945,"y":492,"width":95,"height":26},
		{"id":"text_0295","type":"text","text":"两种极端","x":-2377,"y":2679,"width":79,"height":26},
		{"id":"text_0296","type":"text","text":"DQN的两大问题","x":-2150,"y":351,"width":130,"height":26},
		{"id":"text_0297","type":"text","text":"DQN的衍生改进","x":-2150,"y":634,"width":130,"height":26},
		{"id":"text_0298","type":"text","text":"λ=0","x":-2495,"y":2628,"width":42,"height":26},
		{"id":"text_0299","type":"text","text":"λ=1","x":-2495,"y":2729,"width":42,"height":26},
		{"id":"text_0300","type":"text","text":"DQN + target net","x":-2375,"y":585,"width":145,"height":26},
		{"id":"text_0301","type":"text","text":"Dueling DQN","x":-2341,"y":634,"width":110,"height":26},
		{"id":"text_0302","type":"text","text":"Rainbow DQN","x":-2348,"y":678,"width":119,"height":26},
		{"id":"text_0303","type":"text","text":"DDQN","x":-2515,"y":585,"width":60,"height":26},
		{"id":"text_0304","type":"text","text":"高估问题","x":-2305,"y":231,"width":79,"height":26},
		{"id":"text_0305","type":"text","text":"狗追尾巴问题","x":-2338,"y":472,"width":111,"height":26},
		{"id":"text_0306","type":"text","text":"也称为自举问题，DQN的训练过程可以看做一个“回归\n问题”，但是回归（要拟合）的目标yt总是在变，所以提","x":-2830,"y":450,"width":418,"height":48},
		{"id":"text_0307","type":"text","text":"升了训练的难度。","x":-2693,"y":491,"width":144,"height":26},
		{"id":"text_0308","type":"text","text":"DQN在选择和评估动作时，动作价值Q常被过高估计，导","x":-2798,"y":221,"width":418,"height":26},
		{"id":"text_0309","type":"text","text":"致策略优化出现偏差，影响最终性能。","x":-2734,"y":240,"width":289,"height":26},
		{"id":"text_0310","type":"text","text":"基于表格","x":-1777,"y":-525,"width":79,"height":26},
		{"id":"text_0311","type":"text","text":"奖励的折扣因子，取值范围是[0, 1]","x":-2061,"y":2420,"width":262,"height":26},
		{"id":"text_0312","type":"text","text":"作用","x":-1845,"y":2491,"width":46,"height":26},
		{"id":"text_0313","type":"text","text":"（1）调节近期和远期奖励：较低的γ（接近0）表示更关注近期奖励；较高的γ（接近1）则表示更关注远期的奖励。","x":-2779,"y":2468,"width":837,"height":26},
		{"id":"text_0314","type":"text","text":"（2）间接影响偏差和方差：较高的γ使得远期的奖励对当前估计有更大的影响，这有助于更准确地反映长期回报，从而降低偏差.较低的γ主要关注近期奖励，这可能导致长期回报的估计偏差较高","x":-3333,"y":2513,"width":1390,"height":26},
		{"id":"text_0315","type":"text","text":"Q(S\n​,A\n​) ←\nt\nt\nQ(S\n​,A\n​) +\nt\nt\nα R\n​ + γ max\n​ Q(S\n​,a) −Q(S\n​,A\n​)\n[\nt+1\na\nt+1\nt\nt ]","x":-2016,"y":-753,"width":349,"height":60},
		{"id":"text_0316","type":"text","text":"Q-Learning的Loss","x":-1782,"y":-639,"width":149,"height":26},
		{"id":"text_0317","type":"text","text":"Self-Play简介","x":-1541,"y":-3731,"width":113,"height":26},
		{"id":"text_0318","type":"text","text":"计算原理","x":-1777,"y":2324,"width":79,"height":26},
		{"id":"text_0319","type":"text","text":"自博弈（Self-Play）是一种强化学习技术，通过让智能体与自身或其不同版本进行博弈交互，不断优化和改进策略。","x":-2531,"y":-3860,"width":842,"height":31},
		{"id":"text_0320","type":"text","text":"Self-Play应用","x":-1729,"y":-3605,"width":113,"height":26},
		{"id":"text_0321","type":"text","text":"Generalized Advantage Estimation, 广义优势估计","x":-2001,"y":2044,"width":382,"height":26},
		{"id":"text_0322","type":"text","text":"借鉴了TD(λ)算法的思路","x":-1802,"y":2093,"width":186,"height":26},
		{"id":"text_0323","type":"text","text":"GAE算法通过多个时间步的TD误差δ的加权和来估计优势函数A，并通过λ因子对这些时间步的δ进行衰减调节。","x":-2447,"y":2141,"width":804,"height":26},
		{"id":"text_0324","type":"text","text":"GAE算法的递归公式","x":-2417,"y":2209,"width":159,"height":26},
		{"id":"text_0325","type":"text","text":"TD(λ)算法通过调节λ因子在偏差和方差之间取得平衡，GAE算法也使用λ因子以达到类似的目的。","x":-2586,"y":2093,"width":706,"height":26},
		{"id":"text_0326","type":"text","text":"全称 State–Action–Reward–State–Action","x":-1614,"y":-874,"width":327,"height":26},
		{"id":"text_0327","type":"text","text":"Q(S\n​,A\n​) ←\nt\nt\nQ(S\n​,A\n​) +\nt\nt\nα R\n​ + γQ(S\n​,A\n​) −Q(S\n​,A\n​)\n[\nt+1\nt+1\nt+1\nt\nt ]","x":-1662,"y":-831,"width":327,"height":60},
		{"id":"text_0328","type":"text","text":"单步TD（One-step TD）、多步TD（n-step TD）与TD(λ)","x":-1881,"y":-1180,"width":434,"height":26},
		{"id":"text_0329","type":"text","text":"TD(0)、TD(n)、TD(lambda)","x":-1529,"y":-1012,"width":220,"height":26},
		{"id":"text_0330","type":"text","text":"TD(λ)","x":-2150,"y":-1180,"width":56,"height":26},
		{"id":"text_0331","type":"text","text":"TD方法的核心思想是利用当前的价值估计来更新价值函数，基于当前的价值估计进行自举（Bootstrapping）学习，这本质上基于贝尔曼方程。","x":-2350,"y":-2303,"width":1038,"height":26},
		{"id":"text_0332","type":"text","text":"贝尔曼期望方程","x":-1435,"y":-2039,"width":127,"height":26},
		{"id":"text_0333","type":"text","text":"TD方法","x":-1376,"y":-1607,"width":69,"height":26},
		{"id":"text_0334","type":"text","text":"TD目标（TD Target）和TD误差（TD Error）","x":-1652,"y":-1431,"width":348,"height":26},
		{"id":"text_0335","type":"text","text":"应用更为普遍","x":-1031,"y":-3906,"width":111,"height":26},
		{"id":"text_0336","type":"text","text":"TD Target","x":-1816,"y":-1532,"width":92,"height":26},
		{"id":"text_0337","type":"text","text":"TD Error","x":-1804,"y":-1461,"width":79,"height":26},
		{"id":"text_0338","type":"text","text":"图示","x":-1772,"y":-1330,"width":46,"height":26},
		{"id":"text_0339","type":"text","text":"AlphaGo","x":-1883,"y":-3697,"width":76,"height":26},
		{"id":"text_0340","type":"text","text":"OpenAI Five","x":-1909,"y":-3513,"width":103,"height":26},
		{"id":"text_0341","type":"text","text":"John Schulman","x":-2207,"y":2044,"width":128,"height":26},
		{"id":"text_0342","type":"text","text":"PPO","x":-2033,"y":-3536,"width":48,"height":26},
		{"id":"text_0343","type":"text","text":"plays 180 years worth of games against itself every day, learning via self-play","x":-2732,"y":-3491,"width":595,"height":26},
		{"id":"text_0344","type":"text","text":"AlphaGoZero在训练时的性能增长趋势","x":-2255,"y":-3697,"width":290,"height":26},
		{"id":"text_0345","type":"text","text":"更新公式","x":-1529,"y":-1607,"width":79,"height":26},
		{"id":"text_0346","type":"text","text":"状态价值函数的贝尔曼方程","x":-1823,"y":-2189,"width":208,"height":26},
		{"id":"text_0347","type":"text","text":"动作价值函数的贝尔曼方程","x":-1823,"y":-2089,"width":208,"height":26},
		{"id":"text_0348","type":"text","text":"Q和V的转换关系","x":-1643,"y":-1856,"width":132,"height":26},
		{"id":"text_0349","type":"text","text":"MC的定义","x":-1134,"y":-2672,"width":87,"height":26},
		{"id":"text_0350","type":"text","text":"蒙特卡洛法预估状态St的价值","x":-1269,"y":-2488,"width":225,"height":26},
		{"id":"text_0351","type":"text","text":"离散动作空间（Discrete Action Space）","x":-1149,"y":-4031,"width":308,"height":26},
		{"id":"text_0352","type":"text","text":"连续动作空间（Continuous Action Space）","x":-1174,"y":-3964,"width":331,"height":26},
		{"id":"text_0353","type":"text","text":"REINFORCE、DPG、DDPG、TD3、TRPO、PPO、","x":-1657,"y":-3974,"width":392,"height":26},
		{"id":"text_0354","type":"text","text":"SAC","x":-1483,"y":-3954,"width":44,"height":26},
		{"id":"text_0355","type":"text","text":"Q-Learning、SARSA、DQN、Double DQN、Dueling DQN","x":-1666,"y":-4041,"width":436,"height":26},
		{"id":"text_0356","type":"text","text":"一种基于随机采样的计算方法，利用随机采样来解决在原则上可能是确定性的难题","x":-1835,"y":-2674,"width":597,"height":31},
		{"id":"text_0357","type":"text","text":"无模型\n（Model-Free）","x":-847,"y":-5801,"width":133,"height":45},
		{"id":"text_0358","type":"text","text":"有模型\n（Model-Based）","x":-861,"y":-5623,"width":148,"height":45},
		{"id":"text_0359","type":"text","text":"MDP","x":-804,"y":-6303,"width":50,"height":26},
		{"id":"text_0360","type":"text","text":"POMDP","x":-827,"y":-5900,"width":73,"height":26},
		{"id":"text_0361","type":"text","text":"定义","x":-982,"y":-5685,"width":46,"height":26},
		{"id":"text_0362","type":"text","text":"类型/实例","x":-1022,"y":-5541,"width":85,"height":26},
		{"id":"text_0363","type":"text","text":"动态规划（Dynamic Programming, DP）","x":-1413,"y":-5614,"width":314,"height":26},
		{"id":"text_0364","type":"text","text":"Dyna-Q","x":-1167,"y":-5566,"width":70,"height":26},
		{"id":"text_0365","type":"text","text":"MCTS","x":-1155,"y":-5517,"width":59,"height":26},
		{"id":"text_0366","type":"text","text":"MPC","x":-1145,"y":-5468,"width":50,"height":26},
		{"id":"text_0367","type":"text","text":"部分可观测马尔可夫决策过程（Partially Observable Markov Decision Process，POMDP）","x":-1615,"y":-5900,"width":676,"height":26},
		{"id":"text_0368","type":"text","text":"模型预测控制（Model Predictive Control，MPC）","x":-1607,"y":-5468,"width":385,"height":26},
		{"id":"text_0369","type":"text","text":"POMDP = (S,A,T ,R,O,Z,γ)","x":-2009,"y":-5904,"width":281,"height":33},
		{"id":"text_0370","type":"text","text":"一种基于已知或学习到的系统动力学模型，在每个控制时刻“在线”求解一个有限时域最优控制问题、并只执行其中首个动作，然后滚动前移到下一个时刻再重复该过程的控制策略。","x":-3011,"y":-5471,"width":1310,"height":31},
		{"id":"text_0371","type":"text","text":"通过构建搜索树，模拟未来可能的动作序列，并基于统计方法评估每个节点的价值，从而选择最优策略。蒙特卡洛树搜索还可以与无模型的方法结合使用。","x":-2345,"y":-5517,"width":1116,"height":26},
		{"id":"text_0372","type":"text","text":"作为早期的有模型强化学习算法之一，Dyna-Q结合了Q-learning的直接学习与通过模拟环境模型进行经验回放。","x":-2083,"y":-5568,"width":813,"height":31},
		{"id":"text_0373","type":"text","text":"有模型的方法依赖环境模型进行规划和决策，这意味着智能体已知环境的状态转移概率（P）和奖励函数（R）。","x":-1871,"y":-5707,"width":814,"height":26},
		{"id":"text_0374","type":"text","text":"通过环境模型，智能体可以模拟未来的状态转移，评估不同动作的长期影响。","x":-1671,"y":-5663,"width":565,"height":26},
		{"id":"text_0375","type":"text","text":"马尔可夫链（Markov Chain）","x":-1110,"y":-6488,"width":229,"height":26},
		{"id":"text_0376","type":"text","text":"MDP = (S,A,T ,R,γ)","x":-1086,"y":-6122,"width":205,"height":33},
		{"id":"text_0377","type":"text","text":"动态规划方法利用已知的环境模型，通过递归方式逐步计算每个状态的价值函数，从而推导出最优策略。","x":-2299,"y":-5614,"width":759,"height":26},
		{"id":"text_0378","type":"text","text":"马尔可夫决策过程（Markov Decision Process, MDP）是在马尔可夫链的基础上引入了动作（A）和奖励（R）的概念。","x":-2113,"y":-6189,"width":868,"height":26},
		{"id":"text_0379","type":"text","text":"定义","x":-969,"y":-5827,"width":46,"height":26},
		{"id":"text_0380","type":"text","text":"类型/实例","x":-1009,"y":-5756,"width":85,"height":26},
		{"id":"text_0381","type":"text","text":"行为策略与目标策略是否相同","x":-1112,"y":-7312,"width":225,"height":26},
		{"id":"text_0382","type":"text","text":"在训练过程中，与环境交互与否","x":-1128,"y":-7166,"width":241,"height":26},
		{"id":"text_0383","type":"text","text":"On-policy、Off-policy、Online RL、Offline RL的区别","x":-1297,"y":-6793,"width":403,"height":26},
		{"id":"text_0384","type":"text","text":"DQN、PPO、GRPO、AC、A2C、A3C、SAC ...","x":-1439,"y":-5756,"width":352,"height":26},
		{"id":"text_0385","type":"text","text":"马尔可夫链（Markov Chain）是一种具有马尔可夫性质的随机过程，其中每个事件的发生概率仅取决于前一个事件的状态，而与更早的历史状态无关。","x":-2325,"y":-6553,"width":1087,"height":31},
		{"id":"text_0386","type":"text","text":"离散的状态序列（随机过程）S0, S1, S2, …可被称为马尔可夫链","x":-2271,"y":-6502,"width":466,"height":26},
		{"id":"text_0387","type":"text","text":"在线强化学习（Online RL）","x":-1419,"y":-7191,"width":216,"height":26},
		{"id":"text_0388","type":"text","text":"离线强化学习（Offline RL）","x":-1421,"y":-7142,"width":219,"height":26},
		{"id":"text_0389","type":"text","text":"同策略（On-policy）","x":-1354,"y":-7361,"width":166,"height":26},
		{"id":"text_0390","type":"text","text":"异策略（Off-policy）","x":-1357,"y":-7264,"width":169,"height":26},
		{"id":"text_0391","type":"text","text":"又称批量强化学习（Batch RL），在训练过程中，智能体完全不与环境交互，而是在一个与线上环境隔离的环境中进行训练，仅依赖预先收集的数据。","x":-2597,"y":-7145,"width":1087,"height":31},
		{"id":"text_0392","type":"text","text":"举例","x":-1480,"y":-7288,"width":46,"height":26},
		{"id":"text_0393","type":"text","text":"行为策略与目标策略不同，属于不同版本（或不同类型）的策略","x":-1905,"y":-7239,"width":468,"height":26},
		{"id":"text_0394","type":"text","text":"举例","x":-1478,"y":-7385,"width":46,"height":26},
		{"id":"text_0395","type":"text","text":"行为策略与目标策略相同，同一个版本的策略。","x":-1786,"y":-7339,"width":354,"height":31},
		{"id":"text_0396","type":"text","text":"Q-learning、DQN","x":-1702,"y":-7288,"width":144,"height":26},
		{"id":"text_0397","type":"text","text":"在训练过程中，策略持续与环境交互并收集经验，训练数据源源不断地动态生成，目标策略也在通过训练不断进化","x":-2465,"y":-7191,"width":824,"height":26},
		{"id":"text_0398","type":"text","text":"直接从交互经验中学习最优策略或价值函数，而不显式地构建环境模型。","x":-1639,"y":-5849,"width":532,"height":26},
		{"id":"text_0399","type":"text","text":"在实际应用中，无模型方法更为普遍","x":-1316,"y":-5804,"width":273,"height":26},
		{"id":"text_0400","type":"text","text":"SARSA、众多策略梯度方法","x":-1762,"y":-7385,"width":209,"height":26},
		{"id":"text_0401","type":"text","text":"Policy Gradient","x":857,"y":-1057,"width":128,"height":26},
		{"id":"text_0402","type":"text","text":"（策略梯度）","x":866,"y":-1037,"width":111,"height":26},
		{"id":"text_0403","type":"text","text":"基于价值vs基于策略","x":856,"y":2505,"width":160,"height":26},
		{"id":"text_0404","type":"text","text":"策略梯度的定义","x":1061,"y":-3976,"width":127,"height":26},
		{"id":"text_0405","type":"text","text":"REINFORCE","x":1061,"y":-3668,"width":105,"height":26},
		{"id":"text_0406","type":"text","text":"TRPO","x":1061,"y":-3102,"width":59,"height":26},
		{"id":"text_0407","type":"text","text":"PPO","x":1061,"y":-731,"width":48,"height":26},
		{"id":"text_0408","type":"text","text":"GRPO","x":1062,"y":1882,"width":59,"height":26},
		{"id":"text_0409","type":"text","text":"GRPO简介","x":1196,"y":1495,"width":92,"height":26},
		{"id":"text_0410","type":"text","text":"基于PPO改进","x":1195,"y":1843,"width":113,"height":26},
		{"id":"text_0411","type":"text","text":"GRPO目标函数","x":1196,"y":2268,"width":124,"height":26},
		{"id":"text_0412","type":"text","text":"∇\n​J(θ) ≈\nθ\nE\n​\n​ ∇\n​ log π\n​(a\n​ ∣s\n​)G\n​\nτ∼π\n​θ [∑t=0","x":1240,"y":-3674,"width":366,"height":40},
		{"id":"text_0413","type":"text","text":"∞","x":1404,"y":-3677,"width":28,"height":26},
		{"id":"text_0414","type":"text","text":"θ\nθ\nt\nt\nt]","x":1448,"y":-3672,"width":163,"height":34},
		{"id":"text_0415","type":"text","text":"GRPO改进点","x":1382,"y":1698,"width":108,"height":26},
		{"id":"text_0416","type":"text","text":"PPO与GRPO的对比","x":1381,"y":1989,"width":159,"height":26},
		{"id":"text_0417","type":"text","text":"KL","x":1992,"y":2312,"width":34,"height":26},
		{"id":"text_0418","type":"text","text":"GRPO利用组内各输出之间的相对奖励来计算优势 ，具体来说，优势计算基于归一化的奖励","x":2317,"y":2222,"width":663,"height":31},
		{"id":"text_0419","type":"text","text":"（1）移除价值函数","x":1564,"y":1625,"width":153,"height":26},
		{"id":"text_0420","type":"text","text":"（2）群体相对优势估计","x":1564,"y":1674,"width":185,"height":26},
		{"id":"text_0421","type":"text","text":"（3）新的KL散度估计","x":1564,"y":1722,"width":173,"height":26},
		{"id":"text_0422","type":"text","text":"（4）正则化方式的调整","x":1564,"y":1771,"width":185,"height":26},
		{"id":"text_0423","type":"text","text":"Group Relative Policy Optimization, 群体相对策略优化","x":1363,"y":1442,"width":415,"height":26},
		{"id":"text_0424","type":"text","text":"多种奖励","x":1361,"y":1538,"width":79,"height":26},
		{"id":"text_0425","type":"text","text":"GRPO直接将KL散度作为正则项融入损失函数，从而简化了优势 的计算过程。","x":1988,"y":1771,"width":570,"height":26},
		{"id":"text_0426","type":"text","text":"（1）基于规则的奖励","x":1515,"y":1509,"width":169,"height":26},
		{"id":"text_0427","type":"text","text":"（2）基于奖励模型的奖励\n对于许多没有标准答案的问题（例如开放性问题或某些非结构化任务），难以通过规则直接","x":1515,"y":1558,"width":938,"height":36},
		{"id":"text_0428","type":"text","text":"评价模型输出，此时可采用专门训练的奖励模型来为输出评分。","x":1888,"y":1577,"width":468,"height":26},
		{"id":"text_0429","type":"text","text":"利用预定义的函数或工具对模型输出进行校验，并据此赋予奖励分数。","x":1770,"y":1509,"width":516,"height":26},
		{"id":"text_0430","type":"text","text":"DeepSeek","x":1857,"y":1452,"width":89,"height":26},
		{"id":"text_0431","type":"text","text":"GRPO采用了一种新的KL散度估计方法，该方法具备无偏、低方差且结果非负的优点，比PPO的方法更加稳定可靠。","x":1839,"y":1720,"width":843,"height":31},
		{"id":"text_0432","type":"text","text":"GRPO不再单独训练价值函数（模型），从而大幅降低了计算资源和显存的消耗，并显著提升了训练效率。","x":1855,"y":1625,"width":772,"height":26},
		{"id":"text_0433","type":"text","text":"PPO简介","x":1183,"y":-2416,"width":81,"height":26},
		{"id":"text_0434","type":"text","text":"多种变体","x":1183,"y":-1863,"width":79,"height":26},
		{"id":"text_0435","type":"text","text":"PPO衍生","x":1183,"y":953,"width":81,"height":26},
		{"id":"text_0436","type":"text","text":"PPO采用GAE算法来估计优势，而GRPO则基于组内相对奖励直接计算优势，方法更为直观简洁。","x":1919,"y":1674,"width":709,"height":26},
		{"id":"text_0437","type":"text","text":"PPO-Penalty","x":1336,"y":-2227,"width":113,"height":26},
		{"id":"text_0438","type":"text","text":"PPO-Clip","x":1337,"y":-1500,"width":83,"height":26},
		{"id":"text_0439","type":"text","text":"简化为监督学习","x":1337,"y":522,"width":127,"height":26},
		{"id":"text_0440","type":"text","text":"其他多种类型的衍生","x":1337,"y":1384,"width":160,"height":26},
		{"id":"text_0441","type":"text","text":"核心思想是在目标函数中加入KL散度的惩罚项，以限制新策略与旧策略之间的差异","x":1586,"y":-2260,"width":601,"height":26},
		{"id":"text_0442","type":"text","text":"目标函数","x":1521,"y":-2194,"width":79,"height":26},
		{"id":"text_0443","type":"text","text":"PPO的简介","x":1494,"y":-2106,"width":97,"height":26},
		{"id":"text_0444","type":"text","text":"PPO的目标函数","x":1494,"y":-2007,"width":129,"height":26},
		{"id":"text_0445","type":"text","text":"clip的含义和作用","x":1495,"y":-1653,"width":137,"height":26},
		{"id":"text_0446","type":"text","text":"扩展后的PPO","x":1494,"y":-1392,"width":113,"height":26},
		{"id":"text_0447","type":"text","text":"PPO的原理","x":1494,"y":-893,"width":97,"height":26},
		{"id":"text_0448","type":"text","text":"PPO训练中策略模型的更新过程","x":1664,"y":-1059,"width":243,"height":26},
		{"id":"text_0449","type":"text","text":"基于PPO进行RLHF训练的原理图","x":1664,"y":-728,"width":252,"height":26},
		{"id":"text_0450","type":"text","text":"“旧策略”\n所谓“旧策略”或“旧模型”，是指每次迭代开始时的策略或模型。之所以称为“旧”，是相对于第二阶段更新参数后的模型而言的。","x":1980,"y":-976,"width":1237,"height":31},
		{"id":"text_0451","type":"text","text":"目标函数","x":1680,"y":-1438,"width":79,"height":26},
		{"id":"text_0452","type":"text","text":"Loss","x":1680,"y":-1345,"width":49,"height":26},
		{"id":"text_0453","type":"text","text":"通常所说的PPO即指PPO-Clip","x":1664,"y":-2128,"width":231,"height":26},
		{"id":"text_0454","type":"text","text":"应用：RLHF","x":1664,"y":-2084,"width":104,"height":26},
		{"id":"text_0455","type":"text","text":"在PPO和DPO之后，衍生出了多种对齐方法，例如KTO、ORPO、SimPO、IPO、CPO、XPO、Step-DPO、Iterative DPO、RLOO、GRPO 等","x":1571,"y":1375,"width":1035,"height":26},
		{"id":"text_0456","type":"text","text":"DPO","x":1539,"y":522,"width":48,"height":26},
		{"id":"text_0457","type":"text","text":"Proximal Policy Optimization，近端策略优化","x":1339,"y":-2468,"width":346,"height":26},
		{"id":"text_0458","type":"text","text":"PPO演进历史","x":1337,"y":-2364,"width":113,"height":26},
		{"id":"text_0459","type":"text","text":"DPO简介","x":1663,"y":-132,"width":81,"height":26},
		{"id":"text_0460","type":"text","text":"RLHF与DPO的训练架构对比","x":1662,"y":859,"width":220,"height":26},
		{"id":"text_0461","type":"text","text":"DPO训练","x":1663,"y":1176,"width":81,"height":26},
		{"id":"text_0462","type":"text","text":"偏好数据集","x":1818,"y":1090,"width":95,"height":26},
		{"id":"text_0463","type":"text","text":"流程","x":1818,"y":1263,"width":46,"height":26},
		{"id":"text_0464","type":"text","text":"构建","x":1987,"y":1090,"width":46,"height":26},
		{"id":"text_0465","type":"text","text":"Direct Preference Optimization，直接偏好优化","x":1820,"y":-460,"width":362,"height":26},
		{"id":"text_0466","type":"text","text":"DPO原理","x":1819,"y":197,"width":81,"height":26},
		{"id":"text_0467","type":"text","text":"相比PPO的优势","x":2449,"y":859,"width":129,"height":26},
		{"id":"text_0468","type":"text","text":"一条DPO训练数据形成的两个输入序列","x":2601,"y":1087,"width":291,"height":31},
		{"id":"text_0469","type":"text","text":"DPO的LOSS","x":1975,"y":-102,"width":105,"height":26},
		{"id":"text_0470","type":"text","text":"DPO训练全景图","x":1974,"y":496,"width":129,"height":26},
		{"id":"text_0471","type":"text","text":"（1）流程简洁：DPO直接对策略模型进行优化，不需要预先训练Reward模型（奖励函数）。DPO只需要","x":2654,"y":796,"width":766,"height":26},
		{"id":"text_0472","type":"text","text":"基于预先给定的偏好数据进行训练，无需中途采样。","x":2843,"y":815,"width":387,"height":26},
		{"id":"text_0473","type":"text","text":"（2）稳定性：DPO是一种监督学习方法，摆脱了强化学习训练的不稳定性。","x":2757,"y":857,"width":560,"height":31},
		{"id":"text_0474","type":"text","text":"（3）低开销：DPO在训练过程中只需要加载一个模型（只需加载策略模型，而对于参考模型，可以将参考","x":2652,"y":901,"width":770,"height":31},
		{"id":"text_0475","type":"text","text":"模型的输出结果预先录制好，然后在训练时就不需要加载），算力开销更低，更易于落地实践。","x":2690,"y":923,"width":694,"height":26},
		{"id":"text_0476","type":"text","text":"斯坦福","x":2259,"y":-482,"width":63,"height":26},
		{"id":"text_0477","type":"text","text":"监督学习，简单","x":2259,"y":-437,"width":127,"height":26},
		{"id":"text_0478","type":"text","text":"DPO的目标函数","x":2155,"y":68,"width":129,"height":26},
		{"id":"text_0479","type":"text","text":"DPO的梯度","x":2648,"y":-354,"width":97,"height":26},
		{"id":"text_0480","type":"text","text":"β参数对DPO的影响","x":2648,"y":-191,"width":156,"height":26},
		{"id":"text_0481","type":"text","text":"John Schulman","x":1764,"y":-2468,"width":128,"height":26},
		{"id":"text_0482","type":"text","text":"TRPO简介","x":1193,"y":-3617,"width":92,"height":26},
		{"id":"text_0483","type":"text","text":"TRPO的两个核心概念","x":1193,"y":-3244,"width":173,"height":26},
		{"id":"text_0484","type":"text","text":"TRPO中两种限制策略更新的方法","x":1193,"y":-2586,"width":254,"height":26},
		{"id":"text_0485","type":"text","text":"基于约束","x":1519,"y":-2635,"width":79,"height":26},
		{"id":"text_0486","type":"text","text":"基于惩罚","x":1519,"y":-2538,"width":79,"height":26},
		{"id":"text_0487","type":"text","text":"置信域（Trust Region）","x":1438,"y":-3428,"width":194,"height":26},
		{"id":"text_0488","type":"text","text":"重要性采样（Importance Sampling）","x":1441,"y":-3061,"width":287,"height":26},
		{"id":"text_0489","type":"text","text":"目标函数","x":1672,"y":-2538,"width":79,"height":26},
		{"id":"text_0490","type":"text","text":"隐式奖励","x":2358,"y":159,"width":79,"height":26},
		{"id":"text_0491","type":"text","text":"定义","x":1807,"y":-3217,"width":46,"height":26},
		{"id":"text_0492","type":"text","text":"需满足的条件","x":1807,"y":-3146,"width":111,"height":26},
		{"id":"text_0493","type":"text","text":"原理","x":1807,"y":-2905,"width":46,"height":26},
		{"id":"text_0494","type":"text","text":"隐式奖励差异对参数更新幅度的影响","x":2511,"y":159,"width":273,"height":26},
		{"id":"text_0495","type":"text","text":"重要性权重","x":2966,"y":-2905,"width":95,"height":26},
		{"id":"text_0496","type":"text","text":"如果在某个x上p(x)的概率值大于0，那么p'(x)在同一个位置的概率也必须大于0（p'(x)不能为零，意味着该位置在p'(x)中也有可能性）。","x":2007,"y":-3149,"width":976,"height":31},
		{"id":"text_0497","type":"text","text":"一种基于蒙特卡洛采样思想的方法，经常被用于估计期望值和积分。","x":1938,"y":-3242,"width":500,"height":31},
		{"id":"text_0498","type":"text","text":"该方法基于辅助分布进行采样，并通过重要性权重对估计值进行修正，从而提高采样和估计的效率。","x":1980,"y":-3195,"width":727,"height":26},
		{"id":"text_0499","type":"text","text":"目标函数","x":1672,"y":-2635,"width":79,"height":26},
		{"id":"text_0500","type":"text","text":"TRPO通过限制新策略与旧策略之间的KL距离，将策略更新限制在一个预定的“置信域”δ内","x":2266,"y":-3453,"width":673,"height":31},
		{"id":"text_0501","type":"text","text":"通过限制新旧策略之间的KL散度，确保每次策略更新的幅度适中，避免策略效果出现剧烈波","x":2276,"y":-3406,"width":666,"height":26},
		{"id":"text_0502","type":"text","text":"动。","x":2586,"y":-3387,"width":46,"height":26},
		{"id":"text_0503","type":"text","text":"约束","x":2158,"y":-2635,"width":46,"height":26},
		{"id":"text_0504","type":"text","text":"Trust Region Policy Optimization，置信域策略优化\nJohn Schulman","x":1359,"y":-3617,"width":600,"height":26},
		{"id":"text_0505","type":"text","text":"策略梯度（Policy Gradient）方法通过直接优化策略以最大化回报（累积奖励），衍生出多种强化学习算法，可统称为基于策略（Policy-Based）的方法。","x":1274,"y":-4212,"width":1120,"height":26},
		{"id":"text_0506","type":"text","text":"策略梯度定理","x":1263,"y":-4085,"width":111,"height":26},
		{"id":"text_0507","type":"text","text":"策略梯度的原理","x":1263,"y":-3868,"width":127,"height":26},
		{"id":"text_0508","type":"text","text":"策略梯度的应用\n涵盖了A2C、SAC、TD3、PPO以及GRPO等一系列知名算法","x":1263,"y":-3722,"width":785,"height":31},
		{"id":"text_0509","type":"text","text":"假设通过实际运行收集到N条轨迹","x":1942,"y":-4134,"width":253,"height":26},
		{"id":"text_0510","type":"text","text":"一条轨迹的策略梯度","x":1941,"y":-4038,"width":160,"height":31},
